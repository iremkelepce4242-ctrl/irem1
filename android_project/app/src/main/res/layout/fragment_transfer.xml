<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1F5F9"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEPOLAR ARASI STOK TRANSFERİ"
        android:textColor="#0F172A"
        android:textStyle="bold"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etCikisDepo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:hint="Çıkış Deposu / Şube"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <EditText
        android:id="@+id/etGirisDepo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:hint="Giriş Deposu / Şube"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTransferKalemler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnTransferOnayla"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#1E88E5"
        android:text="TRANSFERİ TAMAMLA"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</LinearLayout>
