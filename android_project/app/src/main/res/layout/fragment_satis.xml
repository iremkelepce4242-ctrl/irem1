<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1F5F9"
    android:padding="16dp">

    <!-- Cari Seçimi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MÜŞTERİ / CARİ SEÇİMİ"
        android:textColor="#475569"
        android:textStyle="bold"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spnrCari"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@android:drawable/btn_dropdown" />

    <!-- Sepet Listesi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="SATIŞ SEPETİ"
        android:textColor="#475569"
        android:textStyle="bold"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSepet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <!-- Toplam & Ödeme Butonu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ÖDENECEK NET TUTAR"
                android:textColor="#1E88E5"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvToplamTutar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00 TL"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="20sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSatisTamamla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#1E88E5"
            android:text="SATIŞI TAMAMLA"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
