<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="20dp"
    android:gravity="center">

    <!-- Logo / İkon Kutusu -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="#10B981"
        android:gravity="center"
        android:layout_marginBottom="24dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ST"
            android:textColor="#0F172A"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stok &amp; Cari Takip"
        android:textColor="#F8FAFC"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="%100 Supabase PostgreSQL Backend"
        android:textColor="#10B981"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- Durum Kartı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supabase Bağlantı Durumu:"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bağlantı kuruluyor..."
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Veriler senkronize ediliyor"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="🔄 Verileri Yenile / Test Et"
        android:backgroundTint="#10B981"
        android:textColor="#0F172A"
        android:textStyle="bold"
        android:textSize="15sp" />

</LinearLayout>
